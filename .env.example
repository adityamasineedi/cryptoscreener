# Production: always true. Never fabricate market data when true.

USE_REAL_DATA=true



# API

API_HOST=0.0.0.0

API_PORT=8000

API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000

LOG_LEVEL=INFO

# Frontend (bake into Vite build). Prefer direct backend URLs so preview/dev
# WebSockets do not depend on the Vite proxy (avoids ECONNABORTED reconnect loops).
# VITE_API_URL=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000



# Redis — optional for local/dev (in-memory fallback when false)
# Keep true in production so screener/alerts/OI caches survive restarts.

REDIS_URL=redis://localhost:6379/0

REDIS_ENABLED=false



# PostgreSQL / TimescaleDB — optional for local/dev
# Keep true in production for OHLCV / setups / paper / alerts durability.

DATABASE_URL=postgresql+asyncpg://screener:screener@localhost:5432/cryptoscreener

DATABASE_ENABLED=false



# Binance public endpoints (no API key required for market data)

BINANCE_SPOT_REST=https://api.binance.com

BINANCE_FUTURES_REST=https://fapi.binance.com

BINANCE_SPOT_WS=wss://stream.binance.com:9443

# Base host only — code appends /market/ws for USD-M market streams
BINANCE_FUTURES_WS=wss://fstream.binance.com



# Rate limits (conservative defaults)

BINANCE_REST_WEIGHT_PER_MINUTE=1100

BINANCE_REST_MAX_CONCURRENCY=5

COINGECKO_REQUESTS_PER_MINUTE=25

DEFILLAMA_REQUESTS_PER_MINUTE=60



# Optional provider keys (never expose to frontend)

COINGECKO_API_KEY=

DEFILLAMA_API_KEY=

ONCHAIN_API_KEY=

# Sentiment: default is free_social (socialtickers + XOOMAR) — no key required.
# Optional paid LunarCrush — only if providers.yaml sentiment.provider: lunarcrush
LUNARCRUSH_API_KEY=

SENTIMENT_API_KEY=



# Stale thresholds (seconds)

STALE_TICKER_SECONDS=15

STALE_FUNDAMENTAL_SECONDS=900

UNAVAILABLE_AFTER_SECONDS=60



# Ingestion

SYMBOL_REFRESH_SECONDS=300

SUBSCRIBE_QUOTE=USDT

MAX_WS_STREAMS_PER_CONNECTION=900



# Open interest scheduler

OI_REFRESH_SECONDS=120

OI_CONCURRENCY=3

OI_BATCH_SIZE=40

# TOP_MARKET_CAP | TOP_VOLUME | WATCHLIST | FULL_UNIVERSE
OI_PRIORITY_MODE=TOP_MARKET_CAP

# Only REST-poll this many large-cap symbols (+ visible/watchlist)
OI_TOP_N=40

# Virtual paper trading (no real exchange orders)
PAPER_TRADE_ENABLED=true
PAPER_STARTING_EQUITY=1000
PAPER_RISK_PERCENT=0.02
# path_a = Trend+BOS (research); path_b = full LONG_ENTRY_CANDIDATE only
PAPER_ENTRY_MODE=path_a
# Legacy 15m setup→paper auto-entry (RESEARCH_15M). Keep false — v1 uses V1PaperWatcher only.
PAPER_LEGACY_AUTO_ENTRY_ENABLED=false
# Risk gates — block small/meme/unknown mcap; tiered risk; liq spike pause
PAPER_RISK_GATES_ENABLED=true
PAPER_ALLOWED_GROUPS=BTC,ETH,large-cap,mid-cap
PAPER_MIN_QUOTE_VOLUME_24H=5000000
PAPER_RISK_PCT_BTC_ETH=0.02
PAPER_RISK_PCT_LARGE=0.02
PAPER_RISK_PCT_MID=0.01
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_OPEN_RISK_PCT=0.10
PAPER_LIQ_GATE_ENABLED=true
PAPER_LIQ_MIN_LONG_NOTIONAL_5M=25000
# COMBO_02 v1 production profile (BTC core 1.5%; ETH/SOL secondary 0.5%; universe BTC/ETH/SOL)
PAPER_V1_PROFILE_ENABLED=true
PAPER_V1_UNIVERSE_ONLY=true
PAPER_V1_SECONDARY_ENABLED=true
# 1h COMBO_02 v1 watcher (same evaluate_combination_at_bar path as backtest)
PAPER_V1_WATCHER_ENABLED=true
PAPER_V1_TIMEFRAME=1h
# Keep Telegram off until BTC 1h replay parity passes
PAPER_V1_TELEGRAM_ENABLED=false
PAPER_V1_REPLAY_MODE=false

# Telegram alerts for v1 paper trades (PAPER_ENTRY / PAPER_EXIT via AlertFeed).
# Also requires PAPER_V1_TELEGRAM_ENABLED=true. Create a bot via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Research gates for live ENTRY candidates — keep false unless reviewing larger-sample studies
RESEARCH_GATE_ENABLED=false
RESEARCH_GATE_BLOCK_SHORTS=false
RESEARCH_GATE_BLOCK_HTF_CONFLICT=false

# System Diagnostics / Issue Center
DIAG_UI_REFRESH_SECONDS=5
DIAG_EXPENSIVE_METRICS_SECONDS=30
DIAG_DISK_WARNING_PCT=70
DIAG_DISK_ERROR_PCT=85
DIAG_DISK_CRITICAL_PCT=95
DIAG_MEMORY_WARNING_PCT=80
DIAG_MEMORY_ERROR_PCT=90
DIAG_MEMORY_CRITICAL_PCT=95
DIAG_CPU_WARNING_PCT=85
DIAG_CPU_ERROR_PCT=95
DIAG_EVENT_RETENTION_DAYS=30
DIAG_RESOLVED_ISSUE_RETENTION_DAYS=90
DIAG_SNAPSHOT_RETENTION_DAYS=90
DIAG_RESOURCE_SAMPLE_RETENTION_DAYS=7
DIAG_WS_STALE_SECONDS=120
DIAG_DB_LONG_QUERY_SECONDS=30
DIAG_DB_POOL_WARNING_PCT=80
DIAG_DB_POOL_ERROR_PCT=95
DIAGNOSTICS_DB_DETAIL_CACHE_SECONDS=60
DIAG_REST_429_WARNING=5
DIAG_JOB_STALE_HEARTBEAT_SECONDS=300
# Phase 3 — backups / snapshots (no auto-delete)
BACKUP_DESTINATION=data/diagnostics/backups
BACKUP_MIN_FREE_SPACE_GB=5
BACKUP_RETENTION_DAYS=90
BACKUP_PG_DUMP_PATH=
BACKUP_PG_RESTORE_PATH=
SNAPSHOT_DESTINATION=data/diagnostics/snapshots

