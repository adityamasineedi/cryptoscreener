# Production: always true. Never fabricate market data when true.

USE_REAL_DATA=true



# API

API_HOST=0.0.0.0

API_PORT=8000

API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=INFO



# Redis — optional for local/dev (in-memory fallback when false)

REDIS_URL=redis://localhost:6379/0

REDIS_ENABLED=false



# PostgreSQL / TimescaleDB — optional for local/dev

DATABASE_URL=postgresql+asyncpg://screener:screener@localhost:5432/cryptoscreener

DATABASE_ENABLED=false



# Binance public endpoints (no API key required for market data)

BINANCE_SPOT_REST=https://api.binance.com

BINANCE_FUTURES_REST=https://fapi.binance.com

BINANCE_SPOT_WS=wss://stream.binance.com:9443

BINANCE_FUTURES_WS=wss://fstream.binance.com



# Rate limits (conservative defaults)

BINANCE_REST_WEIGHT_PER_MINUTE=1100

BINANCE_REST_MAX_CONCURRENCY=5

COINGECKO_REQUESTS_PER_MINUTE=25

DEFILLAMA_REQUESTS_PER_MINUTE=60



# Optional provider keys (never expose to frontend)

COINGECKO_API_KEY=

DEFILLAMA_API_KEY=

ONCHAIN_API_KEY=

SENTIMENT_API_KEY=



# Stale thresholds (seconds)

STALE_TICKER_SECONDS=15

STALE_FUNDAMENTAL_SECONDS=900

UNAVAILABLE_AFTER_SECONDS=60



# Ingestion

SYMBOL_REFRESH_SECONDS=300

SUBSCRIBE_QUOTE=USDT

MAX_WS_STREAMS_PER_CONNECTION=900



# Open interest scheduler

OI_REFRESH_SECONDS=120

OI_CONCURRENCY=3

OI_BATCH_SIZE=40

# TOP_MARKET_CAP | TOP_VOLUME | WATCHLIST | FULL_UNIVERSE
OI_PRIORITY_MODE=TOP_MARKET_CAP

# Only REST-poll this many large-cap symbols (+ visible/watchlist)
OI_TOP_N=40

