  "max_alerts": 20,
  "window_minutes": 60
 },
 "tracking": {
  "max_track_bars": 200
 },
 "daily_summary_hour_utc": 0,
 "poll_seconds": 30,
 "defer_missing_engine_values_seconds": 300,
