  "bot_token_env": "TELEGRAM_BOT_TOKEN",
  "chat_id_env": "TRADE_ALERTS_TELEGRAM_CHAT_ID",
  "timeout_seconds": 15
 },
 "labels": [
  {"max_minutes": 15, "label": "SCALP"},
  {"max_minutes": 60, "label": "INTRADAY"},
  {"max_minutes": 1440, "label": "SWING"}
 ],
 "entry_zone": {
  "atr_period": 14,
